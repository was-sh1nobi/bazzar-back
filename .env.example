DATABASE_URL=./bazzar.db
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
WEBSITE_URL=https://revokers.com/support

# Secret used to sign /ui dashboard session JWTs — REQUIRED in production.
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# --- Rate limiting (requests per window per IP) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MC_MAX=120
RATE_LIMIT_UI_MAX=300
RATE_LIMIT_UI_API_MAX=120

# Shared secret between Paper plugin and backend — OPTIONAL, only checked when
# REQUIRE_PLUGIN_SECRET=1. Plugin sends it as `x-plugin-secret` on every
# mutating request (shop buy/sell, auction list, items/*). Without enforcement
# any curl can spoof any playerUuid — only leave off on trusted networks/dev.
# Generate: openssl rand -hex 32
PLUGIN_SECRET=change-me-to-a-strong-random-hex

# Set to 1 to REQUIRE x-plugin-secret on mutating MC endpoints.
# Default 0 (off) so the plugin works without configuring any secret.
REQUIRE_PLUGIN_SECRET=0

# Set to 1 ONLY when deployed behind a reverse proxy that sets X-Forwarded-For,
# otherwise client IPs (and thus rate limits) can be spoofed.
TRUST_PROXY=0
