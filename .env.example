DATABASE_URL=./bazzar.db
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
WEBSITE_URL=https://revokers.com/support

# Secret used to sign /ui dashboard session JWTs — REQUIRED in production.
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# --- Rate limiting (requests per window per IP) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MC_MAX=120
RATE_LIMIT_UI_MAX=300
RATE_LIMIT_UI_API_MAX=120

# Shared secret between Paper plugin and backend — REQUIRED in production.
# Plugin sends it as `x-plugin-secret` on every mutating request (shop buy/sell,
# auction list, items/*). Without it any curl can spoof any playerUuid.
# Generate: openssl rand -hex 32  — must match `plugins/bazzar/.env` API_SECRET
PLUGIN_SECRET=change-me-to-a-strong-random-hex

# Set to 1 ONLY when deployed behind a reverse proxy that sets X-Forwarded-For,
# otherwise client IPs (and thus rate limits) can be spoofed.
TRUST_PROXY=0
